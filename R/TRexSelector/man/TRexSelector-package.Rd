\section{T-Rex selectors and controls (\code{TRex*Selector}, \verb{trex_*})}{

The R6 selectors \link{TRexSelector}, \link{TRexDASelector}, \link{TRexGVSSelector},
\link{TRexScreeningSelector}, \link{TRexBiobankScreeningSelector}, \link{TRexSPCASelector}
and \link{TRexTikhonovSelector}; their control lists \link{trex_control},
\link{trex_da_control}, \link{trex_gvs_control}, \link{trex_screen_control},
\link{trex_biobank_control}, \link{trex_spca_control}, \link{trex_tikhonov_control} and
\link{trex_dummy_distribution}; the helpers \link{trex_normalize_design} and
\link{trex_gamma_to_k}; the evaluation metrics \link{trex_fdp}, \link{trex_tpp},
\link{trex_precision}, \link{trex_recall}, \link{trex_fdp_dense} and \link{trex_tpp_dense}.
}

\section{T-solvers (\verb{T*_Solver}, \verb{tsolver_*})}{

The terminating solvers as R6 classes, constructed as
\verb{$new(X, D, y, [groups | tikhonov_K,] options)} with \link{tsolver_options}:
the LARS family (\link{TLARS_Solver}, \link{TLASSO_Solver}, \link{TSTEPWISE_Solver},
\link{TSTAGEWISE_Solver}, \link{TENET_Solver}, \link{TENETAug_Solver}, \link{TIENET_Solver},
\link{TIENETAug_Solver}, \link{TIKNET_Solver}), the OMP family (\link{TOMP_Solver},
\link{TGP_Solver}, \link{TACGP_Solver}, \link{TMP_Solver}, \link{TOOLS_Solver},
\link{TNCGMP_Solver}), the AFS solver \link{TAFS_Solver}, and the
coordinate-descent family (\link{TCDLASSO_Solver}, \link{TCDENET_Solver},
\link{TCDIENET_Solver}, \link{TCDTIKNET_Solver}). The solvers work on the caller's
matrices without copying and may preprocess them in place; the
writer/reader contract and \verb{$restore()} are described in \link{tsolver_options}
and \link{TSolver_Base}.
}

\section{ML methods (\verb{ML*}, \verb{ml_*})}{

Scalers \link{MLZScoreScaler} and \link{MLLpNormScaler}; regressions \link{MLRidge},
\link{MLRidgeCV}, \link{MLElasticNet} and \link{MLElasticNetCV}; decompositions \link{MLSVD}
and \link{MLPCA}; hierarchical clustering \link{ml_agglomerative_cluster} and
\link{ml_cut_tree} with the constants \link{ml_linkage_method} and
\link{ml_distance_metric}.
}

\section{Memory-mapped matrices (\verb{mem_*})}{

\link{mem_matrix} opens or creates a disk-backed matrix and \link{mem_matrix_from}
writes an in-memory matrix to one; every selector, solver and ML method
accepts the result in place of a matrix.
}

